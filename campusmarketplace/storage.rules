rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Listing images: Publicly viewable, uploadable by authenticated users
    match /listings/{listingId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Profile photos: Publicly viewable, editable only by profile owner
    match /profile_photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
